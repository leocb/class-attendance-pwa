{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "class-attendance-pwa",
  "account_id": "cbccd23973b3b71b305a4e8efc1c4562",
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "alunos.leobottaro.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/time",
      "/api/*",
      "/sw.js",
      "/zxing_reader.wasm"
    ]
  },
  "vars": {
    "FIREBASE_FUNCTIONS_BASE_URL": "https://southamerica-east1-classroom-attendance-a03af.cloudfunctions.net",
    "GET_SERVER_TIME_URL": "",
    "PASSKEY_AUTH_URL": ""
  }
}
