rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Original selfies uploaded by students. Only Cloud Functions read these
    // (Admin SDK bypasses rules); clients upload but never download.
    match /selfies/{sid}/{fileName} {
      allow get, list: if false;

      allow create: if request.auth != null
        && sid.size() >= 1 && sid.size() <= 64
        && fileName.matches('^[A-Z2-7]{8}\\.webp$')
        && request.resource.size <= 1048576
        && request.resource.contentType == 'image/webp'
        && request.resource.metadata != null
        && request.resource.metadata.deviceUid == request.auth.uid
        && request.resource.metadata.fingerprint is string
        && fileName == request.resource.metadata.fingerprint + '.webp';

      allow update, delete: if false;
    }

    // Per-teacher verified copies. The CF writes them; the owning teacher reads.
    match /teacher-selfies/{teacherUid}/{sid}/{fileName} {
      allow get: if request.auth != null
        && request.auth.token.teacher == true
        && request.auth.uid == teacherUid;

      allow list, create, update, delete: if false;
    }
  }
}
