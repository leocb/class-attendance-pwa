rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /selfies/{sid}/{fileName} {
      // Only teachers authorized for this student can download directly.
      allow get: if request.auth != null
        && request.auth.token.teacher == true
        && request.auth.uid in firestore.get(/databases/(default)/documents/students/$(sid)).data.authorizedTeacherUids;

      allow list: if false;

      // Students upload their own immutable WebP selfie (<= 1 MB, exact fingerprint filename).
      allow create: if request.auth != null
        && sid.size() >= 1 && sid.size() <= 64
        && fileName.matches('^[A-Z2-7]{8}\\.webp$')
        && request.resource.size <= 1048576
        && request.resource.contentType == 'image/webp'
        && request.resource.metadata != null
        && request.resource.metadata.deviceUid == request.auth.uid
        && request.resource.metadata.fingerprint is string
        && fileName == request.resource.metadata.fingerprint + '.webp';

      allow update, delete: if false;
    }
  }
}
