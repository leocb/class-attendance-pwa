rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null && request.auth.token.teacher == true;
    }

    match /students/{sid} {
      // Only teachers who have scanned this student (and are therefore in
      // authorizedTeacherUids) can read a specific student document.
      allow get: if isTeacher()
        && request.auth.uid in resource.data.authorizedTeacherUids;

      // No directory enumeration, ever.
      allow list: if false;

      // Students create their own document (strict schema + deviceUid must match).
      allow create: if request.auth != null
        && sid.size() >= 1 && sid.size() <= 64
        && request.resource.data.keys().hasOnly([
          'schoolStudentId',
          'name',
          'deviceUid',
          'publicKeyJwk',
          'keyFingerprint',
          'selfiePath',
          'selfieHash',
          'registrationTimestamp',
          'authorizedTeacherUids',
          'rotatedKeys'
        ])
        && request.resource.data.schoolStudentId == sid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.deviceUid == request.auth.uid
        && request.resource.data.publicKeyJwk is map
        && request.resource.data.publicKeyJwk.kty == 'EC'
        && request.resource.data.publicKeyJwk.crv == 'P-256'
        && request.resource.data.publicKeyJwk.x is string
        && request.resource.data.publicKeyJwk.y is string
        && request.resource.data.keyFingerprint is string
        && request.resource.data.keyFingerprint.matches('^[A-Z2-7]{8}$')
        && request.resource.data.selfiePath == 'selfies/' + sid + '/' + request.resource.data.keyFingerprint + '.webp'
        && request.resource.data.selfieHash is string
        && request.resource.data.selfieHash.matches('^[0-9a-f]{64}$')
        && request.resource.data.registrationTimestamp is int
        && request.resource.data.registrationTimestamp > 0
        && request.resource.data.authorizedTeacherUids is list
        && request.resource.data.authorizedTeacherUids.size() == 0
        && request.resource.data.rotatedKeys is list
        && request.resource.data.rotatedKeys.size() == 0;

      // All updates flow through Cloud Functions (admin SDK bypasses rules).
      allow update, delete: if false;
    }

    match /classes/{cid} {
      allow get, list: if isTeacher()
        && resource.data.teacherUid == request.auth.uid;
      allow create: if isTeacher()
        && cid.size() >= 1 && cid.size() <= 128
        && request.resource.data.keys().hasOnly([
          'classId',
          'name',
          'teacherUid',
          'studentIds',
          'createdAt'
        ])
        && request.resource.data.classId == cid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.studentIds is list
        && request.resource.data.studentIds.size() == 0
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt > 0;
      // Updates to studentIds happen only via Cloud Functions.
      allow update, delete: if false;
    }

    match /attendance/{aid} {
      allow read: if isTeacher()
        && resource.data.teacherUid == request.auth.uid;
      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly([
          'attendanceId',
          'classId',
          'sessionDate',
          'schoolStudentId',
          'teacherUid',
          'scannedAt',
          'studentTs',
          'studentKeyFingerprint',
          'signatureValid'
        ])
        && request.resource.data.teacherUid == request.auth.uid
        && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.teacherUid == request.auth.uid
        && request.resource.data.signatureValid == true
        && request.resource.data.sessionDate is string
        && request.resource.data.sessionDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.schoolStudentId is string
        && request.resource.data.schoolStudentId.size() >= 1
        && request.resource.data.schoolStudentId.size() <= 64
        && request.resource.data.studentKeyFingerprint is string
        && request.resource.data.studentKeyFingerprint.matches('^[A-Z2-7]{8}$')
        && request.resource.data.scannedAt is int
        && request.resource.data.scannedAt > 0
        && request.resource.data.studentTs is int
        && request.resource.data.studentTs > 0;
      allow update, delete: if false;
    }

    // Internal WebAuthn tables accessed exclusively by Cloud Functions (Admin SDK).
    match /webauthn_credentials/{credId} {
      allow read, write: if false;
    }

    match /webauthn_challenges/{challengeId} {
      allow read, write: if false;
    }
  }
}
